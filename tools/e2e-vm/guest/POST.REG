REGEDIT4

; MSN connection settings. ConnectProtocol 0x0a = TCP (ENGCT via TCPCONN.DLL to
; PrimaryMSNGateway:569), 0 = modem (MOSCP dialing Phone). Values as written by
; the OSR2 client's own Settings dialog on the reference VM.
[HKEY_CURRENT_USER\Software\Microsoft\MOS\Connection]
"PrimaryMSNGateway"="@HOST_IP@"
"BackupMSNGateway"="@HOST_IP@"
"ConnectProtocol"=dword:@CONNECT_PROTOCOL@
"CurrentCommDev"="Standard Modem"
"Phone"="@PHONE@"
"BackupPhone"="@PHONE@"

; Present once MSN's first-run wizard (MSNSIG13.EXE) has run. Without it the
; desktop icon opens the wizard, which rewrites the Connection values above.
[HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\MOS\SoftwareInstalled]

; Primary network logon "Windows Logon", as the Network control panel writes
; it. With Client for Microsoft Networks as primary, Windows asks for its
; password on every boot once the NIC has a link.
[HKEY_LOCAL_MACHINE\Network\Logon]
"PrimaryProvider"=""

[HKEY_CURRENT_USER\Software\Microsoft\Windows\CurrentVersion\Explorer\Tips]
"Show"=hex:00,00,00,00

; Standard Modem on COM2, where 86Box's Hayes modem sits. Same devnode and
; driver key Unimodem's wizard created on the reference VM.
[HKEY_LOCAL_MACHINE\Enum\Root\MDMGEN\COM2]
"Class"="Modem"
"HardwareID"="MDMGEN"
"DetFlags"=hex:00,00,00,00
"DeviceDesc"="Standard Modem"
"Driver"="Modem\\0000"
"Mfg"="(Standard Modem Types)"
"ConfigFlags"=hex:00,00,00,00
"FriendlyName"="Standard Modem"

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Class\Modem]
@="Modem"
"Installer"="Modem.Cpl"
"Icon"="0"

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Class\Modem\0000]
