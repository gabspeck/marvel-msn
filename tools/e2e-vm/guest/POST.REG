"DeviceType"=hex:01
"InfPath"="MDMGEN.INF"
"InfSection"="Gen"
"DriverDate"=" 8-24-1996"
"DriverDesc"="Standard Modem"
"AttachedTo"="COM2"
"Manufacturer"="(Standard Modem Types)"
"Model"="Standard Modem"
"ID"=hex:e3,55,0b,00
"Default"=hex:00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,00,01,00,00
"DCB"=hex:1c,00,00,00,00,e1,00,00,15,20,00,00,00,00,0a,00,0a,00,08,00,00,11,13,00,00,00,00,c2

[HKEY_LOCAL_MACHINE\System\CurrentControlSet\Services\Class\Modem\0000\Init]
